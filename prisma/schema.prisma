// NUTE — modèle de données du site corporate et du CMS.
// Principe éditorial : aucune réalisation, intervention, personne ou partenaire
// n'est publiée sans être vérifiée. Les champs `isDemo` marquent les contenus
// d'exemple, affichés publiquement avec un badge « Exemple ».

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum MediaCategory {
  BRAND
  TEAM
  PROJECTS
  INTERVENTIONS
  TRAINING
  SEMINARS
  EVENTS
  PRODUCTS
  VIDEOS
  OTHER
}

// ─── Accès & sécurité ────────────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String
  passwordHash   String
  role           Role       @default(EDITOR)
  active         Boolean    @default(true)
  failedLogins   Int        @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  sessions       Session[]
  auditLogs      AuditLog[]
  media          Media[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// ─── Configuration éditoriale ────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SeoMeta {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?
  ogImage     String?
  noindex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Translation {
  id        String   @id @default(cuid())
  locale    String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([locale, key])
}

// ─── Médiathèque ─────────────────────────────────────────────────────

model Media {
  id           String        @id @default(cuid())
  filename     String
  originalName String
  url          String
  thumbUrl     String?
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String        @default("")
  caption      String?
  category     MediaCategory @default(OTHER)
  uploadedById String?
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  galleryItems GalleryItem[]

  @@index([category])
}

/// Galerie polymorphe : relie un média à un projet, une intervention ou un événement.
model GalleryItem {
  id        String  @id @default(cuid())
  ownerType String // "Project" | "Intervention" | "Event"
  ownerId   String
  mediaId   String
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  kind      String  @default("GALLERY") // GALLERY | BEFORE | AFTER
  caption   String?
  order     Int     @default(0)

  @@index([ownerType, ownerId])
}

// ─── Services ────────────────────────────────────────────────────────

model ServiceCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  summary   String
  coverUrl  String?
  coverAlt  String?
  order     Int       @default(0)
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Service {
  id             String          @id @default(cuid())
  slug           String          @unique
  categoryId     String
  category       ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title          String
  summary        String
  description    String
  problem        String?
  audience       String?
  coverUrl       String?
  coverAlt       String?
  order          Int             @default(0)
  published      Boolean         @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ─── Réalisations, interventions, activités ──────────────────────────

model Project {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  category         String
  client           String?
  clientAuthorized Boolean       @default(false)
  location         String?
  date             DateTime?
  summary          String
  problem          String?
  solution         String?
  technologies     String[]
  results          String?
  coverUrl         String?
  coverAlt         String?
  videoUrl         String?
  featured         Boolean       @default(false)
  published        Boolean       @default(false)
  isDemo           Boolean       @default(false)
  interventionId   String?
  intervention     Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([published, category])
}

model Intervention {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  type          String // SCHOOL | UNIVERSITY | COMPANY | INSTITUTION | ORGANIZATION | COMMUNITY | OTHER
  city          String?
  department    String?
  date          DateTime?
  purpose       String
  workPerformed String?
  latitude      Float?
  longitude     Float?
  coverUrl      String?
  coverAlt      String?
  verified      Boolean   @default(false)
  published     Boolean   @default(false)
  isDemo        Boolean   @default(false)
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Event {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  type              String // SEMINAR | TRAINING | CONFERENCE | WORKSHOP | DEMO | VISIT | COMMUNITY | PRESENTATION | PROFESSIONAL | OTHER
  role              String // ORGANIZER | CO_ORGANIZER | SPEAKER | TRAINER | PARTICIPANT | PARTNER | EXHIBITOR
  date              DateTime
  endDate           DateTime?
  location          String?
  summary           String
  description       String?
  topics            String[]
  participantsCount Int?
  certificate       Boolean   @default(false)
  coverUrl          String?
  coverAlt          String?
  videoUrl          String?
  published         Boolean   @default(false)
  isDemo            Boolean   @default(false)
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([published, date])
}

// ─── Équipe ──────────────────────────────────────────────────────────

model TeamMember {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  position         String
  department       String?
  shortBio         String?
  biography        String?
  responsibilities String[]
  /// [{ institution, degree, field?, year? }]
  education        Json     @default("[]")
  /// [{ organization, role, period?, description? }]
  experience       Json     @default("[]")
  skills           String[]
  certifications   String[]
  linkedinUrl      String?
  portfolioUrl     String?
  photoUrl         String?
  photoAlt         String?
  order            Int      @default(0)
  published        Boolean  @default(false)
  isDemo           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Actualités ──────────────────────────────────────────────────────

model Article {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  category       String
  excerpt        String
  content        String
  coverUrl       String?
  coverAlt       String?
  authorName     String
  publishedAt    DateTime?
  published      Boolean   @default(false)
  featured       Boolean   @default(false)
  isDemo         Boolean   @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ─── Preuve sociale (publiée uniquement si authentique / autorisée) ─

model Testimonial {
  id           String   @id @default(cuid())
  author       String
  role         String?
  organization String?
  quote        String
  consent      Boolean  @default(false)
  published    Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Partner {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String?
  websiteUrl String?
  authorized Boolean  @default(false)
  published  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Demandes de contact ─────────────────────────────────────────────

model ContactRequest {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String
  service   String?
  message   String
  status    ContactStatus @default(NEW)
  notes     String?
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

/// Contenu binaire des médias lorsque MEDIA_STORAGE=db (hébergement sans disque persistant).
model MediaFile {
  path      String   @id
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())
}
