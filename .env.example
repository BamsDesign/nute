# ── Base de données (PostgreSQL) ───────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nute?schema=public"

# ── URL publique du site (sans slash final) — utilisée pour SEO, sitemap, OG ──
SITE_URL="https://www.nuteservices.com"

# ── Chemin secret de l'administration (ex. https://site/espace-nute) ──
# /admin renvoie toujours une 404. Choisissez une valeur non devinable.
ADMIN_PATH="espace-nute"

# ── Stockage des fichiers téléversés (hors du dossier public) ──
UPLOAD_DIR="./storage/uploads"

# ── Notification e-mail des demandes de contact (optionnel) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="NUTE Site <no-reply@nuteservices.com>"
CONTACT_NOTIFY_TO="nuteservices@gmail.com"

# ── Création du premier administrateur (npm run admin:create) ──
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# ── Vercel : stockage des médias (obligatoire sur Vercel, disque non persistant) ──
# Vercel → Storage → Blob → Create ; le jeton est ajouté automatiquement au projet.
BLOB_READ_WRITE_TOKEN=""
